[sub_resource type="GDScript" id="GDScript_c8ugw"]
resource_name = "main"
script/source = "extends PlayableCard


func _ready() -> void:
	_update_sprite()


@warning_ignore(\"unused_parameter\")
func _process(delta: float) -> void:
	%NominalLabel.text = \"%s\" % nominal
	
	if not responsive:
		$TextureRect.scale = Vector2.ONE


func _on_mouse_entered() -> void:
	if responsive:
		%HoverSound.play()
		$TextureRect.scale = Vector2.ONE * 1.1


func _on_mouse_exited() -> void:
	if responsive:
		$TextureRect.scale = Vector2.ONE


func _on_state_changed() -> void:
	pass


func _on_visible_state_changed() -> void:
	_update_sprite()


func _add_token(new_token:RuleToken) -> void:
	if new_token.get_parent() == null:
		$CenterContainer.add_child(new_token)
	else:
		new_token.reparent($CenterContainer, false)


func _update_sprite() -> void:
	if visible_state == VisibleState.Hidden:
		$TextureRect.texture = preload(\"res://assets/cards/Рубашка карт.png\")
		%NominalLabel.hide()
		return
		
	%NominalLabel.show()
	match suit:
		Suit.Spades:
			$TextureRect.texture = load(\"res://assets/cards/жезлы/%d.jpg\" % nominal)
		
		Suit.Hearts:
			$TextureRect.texture = load(\"res://assets/cards/чаши/%d.jpg\" % nominal)
		
		Suit.Clubs:
			$TextureRect.texture = load(\"res://assets/cards/мечи/%d.jpg\" % nominal)
		
		Suit.Diamonds:
			$TextureRect.texture = load(\"res://assets/cards/пентакли/%d.jpg\" % nominal)
"

