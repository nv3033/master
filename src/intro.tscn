[sub_resource type="GDScript" id="GDScript_oupes"]
resource_name = "intro"
script/source = "extends Node


const BATTLE_SCENE = preload(\"res://src/battle_scene.tscn\")


func _ready() -> void:
	await get_tree().create_timer(1.0).timeout
	%AnimationPlayer.play(\"camera_transit\")



func _on_animation_player_animation_finished(anim_name: StringName) -> void:
	if anim_name == \"camera_zoom\":
		get_tree().change_scene_to_packed(BATTLE_SCENE)


func _on_voiceover_finished() -> void:
	await get_tree().create_timer(1.0).timeout
	%AnimationPlayer.play(\"camera_zoom\")


func _on_skip_button_pressed() -> void:
	get_tree().change_scene_to_packed(BATTLE_SCENE)
"

