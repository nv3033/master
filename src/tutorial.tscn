[sub_resource type="GDScript" id="GDScript_j0ecg"]
script/source = "extends Control

signal closed_pressed


func _on_back_button_pressed() -> void:
	%ButtonPressedSound.play()
	%NextButton.disabled = false
	%TabContainer.current_tab -= 1
	if %TabContainer.current_tab == 0:
		%BackButton.disabled = true


func _on_next_button_pressed() -> void:
	%ButtonPressedSound.play()
	%BackButton.disabled = false
	%TabContainer.current_tab += 1
	if %TabContainer.current_tab == %TabContainer.get_child_count() - 1:
		%NextButton.disabled = true


func _on_close_button_pressed() -> void:
	closed_pressed.emit()
	%ButtonPressedSound.play()


func _on_close_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_back_button_mouse_entered() -> void:
	if not %BackButton.disabled:
		%ButtonHoverSound.play()


func _on_next_button_mouse_entered() -> void:
	if not %NextButton.disabled:
		%ButtonHoverSound.play()
"

