[sub_resource type="GDScript" id="GDScript_atual"]
resource_name = "universal_token"
script/source = "extends RuleToken


func _ready() -> void:
	_on_visible_state_changed()


@warning_ignore(\"unused_parameter\")
func _process(delta: float) -> void:
	if not responsive:
		$TextureRect.material.set_shader_parameter(\"width\", 0.0)


func _on_mouse_entered() -> void:
	if responsive:
		$TextureRect.material.set_shader_parameter(\"width\", 7.0)
		%HoverSound.play()


func _on_mouse_exited() -> void:
	if responsive:
		$TextureRect.material.set_shader_parameter(\"width\", 0.0)


func _on_visible_state_changed() -> void:
	if visible_state == VisibleState.Visible:
		$TextureRect.texture = setup.image()
	else:
		$TextureRect.texture = preload(\"res://assets/Tokens/Рубашка.png\")
"

[sub_resource type="ShaderMaterial" id="ShaderMaterial_djbvk"]
