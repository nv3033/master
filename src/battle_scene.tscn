[sub_resource type="GDScript" id="GDScript_30cnc"]
resource_name = "ingamemenu"
script/source = "extends ColorRect


func _input(event: InputEvent) -> void:
	if event.is_action_pressed(\"show_ingame_menu\"):
		if visible:
			get_tree().paused = false
			hide()
		else:
			get_tree().paused = true
			show()


func _on_resume_button_pressed() -> void:
	%ButtonClickSound.play()
	get_tree().paused = false
	hide()


func _on_menu_button_pressed() -> void:
	get_tree().paused = false
	get_tree().change_scene_to_file.call_deferred(\"res://main.tscn\")


func _on_resume_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_menu_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_in_game_menu_button_pressed() -> void:
	get_tree().paused = true
	show()


func _on_tutorial_closed_pressed() -> void:
	get_tree().paused = false
	%Tutorial.hide()


func _on_static_table_side_scroll_clicked() -> void:
	get_tree().paused = true
	%Tutorial.show()
"

[sub_resource type="GDScript" id="GDScript_5dwtk"]
resource_name = "sfsdf"
script/source = "extends AudioStreamPlayer


func _on_finished() -> void:
	play()
"

[sub_resource type="GDScript" id="GDScript_uvu22"]
script/source = "extends AudioStreamPlayer


func _on_turst_button_mouse_entered() -> void:
	play()


func _on_dont_trust_button_mouse_entered() -> void:
	play()


func _on_play_token_button_mouse_entered() -> void:
	play()


func _on_save_token_button_mouse_entered() -> void:
	play()


func _on_fix_position_button_mouse_entered() -> void:
	play()
"

