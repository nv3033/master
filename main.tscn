[sub_resource type="GDScript" id="GDScript_7dm0k"]
resource_name = "main"
script/source = "extends Node

const BATTLE_SCENE = preload(\"res://src/battle_scene.tscn\")
const INTRO = preload(\"res://src/intro.tscn\")


func _ready() -> void:
	_on_h_slider_value_changed(%SoundSlider.value)


func _on_play_button_pressed() -> void:
	%ButtonClickSound.play()
	%ShadingRect.show()
	%AnimationPlayer.play(\"shade\")
	await %AnimationPlayer.animation_finished
	get_tree().change_scene_to_packed(INTRO)


func _on_exit_button_pressed() -> void:
	%ButtonClickSound.play()
	get_tree().quit()


func _on_back_menu_button_pressed() -> void:
	%ButtonClickSound.play()
	%AboutUs.hide()
	%Menu.show()


func _on_about_us_button_pressed() -> void:
	%ButtonClickSound.play()
	%Menu.hide()
	%AboutUs.show()


func _on_play_button_mouse_entered() -> void:
	%ButtonHoverSound.play()
	%HandFlame.show()


func _on_play_button_mouse_exited() -> void:
	%HandFlame.hide()


func _on_back_menu_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_about_us_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_exit_button_mouse_entered() -> void:
	%ButtonHoverSound.play()


func _on_h_slider_value_changed(value: float) -> void:
	value = value / 1e9
	var d : float = log(value)
	AudioServer.set_bus_mute(AudioServer.get_bus_index(\"Master\"), d <= -20.0)
	if d > -20.0:
		AudioServer.set_bus_volume_db(AudioServer.get_bus_index(\"Master\"), d)


func _on_toggle_fullscreen_button_toggled(toggled_on: bool) -> void:
	%ButtonClickSound.play()
	if toggled_on:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_FULLSCREEN)
	else:
		DisplayServer.window_set_mode(DisplayServer.WINDOW_MODE_WINDOWED)


func _on_toggle_fullscreen_button_mouse_entered() -> void:
	%ButtonHoverSound.play()
"

